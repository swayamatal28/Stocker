[Unit]
Description=STOCKER ingestion worker
After=network-online.target stocker-api.service

[Service]
Type=simple
User=stocker
Group=stocker
WorkingDirectory=/opt/stocker
EnvironmentFile=/etc/stocker/stocker.env
ExecStart=/opt/stocker/bin/stocker-ingestion
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
