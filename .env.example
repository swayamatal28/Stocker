APP_ENV=development
HTTP_ADDR=:8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=stocker
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
MOCK_PROVIDERS=true
RAW_RETENTION_DAYS=7
# When MOCK_PROVIDERS=false, every source-policy field below is required.
# Do not enable a feed until its terms permit this use and the record is complete.
INGEST_SOURCE_ID=mock-exchange
INGEST_FEED_URL=
INGEST_ATTRIBUTION=Synthetic STOCKER fixture
INGEST_LICENCE=Project-owned test fixture
INGEST_TERMS_URL=https://example.invalid/project-owned-fixture
INGEST_LANGUAGE=en
INGEST_OFFICIAL=false
INGEST_AUTOMATED_ACCESS_ALLOWED=false
INGEST_REQUESTS_PER_MINUTE=10
INGEST_POLL_INTERVAL=1m
INGEST_TIMEOUT=15s
INGEST_POLICY_EXPIRES_AT=
INGEST_REPLAY_DEAD_ON_START=false
OTEL_EXPORTER_OTLP_ENDPOINT=
