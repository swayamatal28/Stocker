# Local application infrastructure
APP_ENV=development
HTTP_ADDR=:8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=stocker
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
JWT_SECRET=insert STOCKER JWT secret of at least 32 random characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Live-only ingestion. Runtime mock providers and seeded demo records are disabled.
MOCK_PROVIDERS=false
RAW_RETENTION_DAYS=7
INGEST_SOURCES_JSON=
INGEST_SOURCES_FILE=configs/news-sources.live.json
INGEST_SOURCE_ID=
INGEST_FEED_URL=
INGEST_ATTRIBUTION=
INGEST_LICENCE=
INGEST_TERMS_URL=
INGEST_LANGUAGE=en
INGEST_OFFICIAL=false
INGEST_AUTOMATED_ACCESS_ALLOWED=false
INGEST_REQUESTS_PER_MINUTE=2
INGEST_POLL_INTERVAL=10m
INGEST_TIMEOUT=15s
INGEST_POLICY_EXPIRES_AT=
INGEST_REPLAY_DEAD_ON_START=false

# Real source documents are analyzed locally by default. Portfolio AI advice is
# unavailable until AI_PROVIDER=http-json and an approved endpoint, key and model
# are supplied. Never put a real credential in this example file.
AI_PROVIDER=local-deterministic
AI_ENDPOINT=
AI_API_KEY=insert AI platform api key
AI_MODEL=stocker-grounded-rules-v1
AI_PROMPT_VERSION=analysis-v1
AI_SCHEMA_VERSION=ai-analysis-v1
AI_REQUEST_TIMEOUT=30s
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_BYTES=65536
AI_REQUEST_COST_CENTS=0
AI_DAILY_BUDGET_CENTS=100
ANALYSIS_CONSUMER=analysis-local-1
ANALYSIS_MAX_ATTEMPTS=5

# Credential-free live NSE quotes. No application secret is sent to this host.
MARKET_PROVIDER=yahoo-finance
MARKET_ENDPOINT=https://query1.finance.yahoo.com
MARKET_ALLOW_INSECURE_HTTP=false
MARKET_REQUEST_TIMEOUT=15s
MARKET_REFRESH_INTERVAL=5m

ALERT_EVALUATION_INTERVAL=1m
MAINTENANCE_INTERVAL=1h
TRANSIENT_RETENTION=24h
ALERT_RETENTION_DAYS=1
BRIEFING_RETENTION_DAYS=1
AUDIT_RETENTION_DAYS=730
OTEL_EXPORTER_OTLP_ENDPOINT=
